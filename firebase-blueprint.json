{
  "entities": {
    "ThumbnailGeneration": {
      "title": "Thumbnail Generation",
      "description": "A record of a thumbnail generation session",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user who generated the thumbnails" },
        "prompt": { "type": "string", "description": "The prompt used for generation" },
        "urls": { "type": "array", "items": { "type": "string" }, "description": "The URLs of the generated images" },
        "imageSize": { "type": "string", "enum": ["1K", "2K", "4K"], "description": "The resolution of the images" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the generation occurred" }
      },
      "required": ["userId", "prompt", "urls", "createdAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about a registered user",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro", "yearly"] },
        "generationsCount": { "type": "number" },
        "lastGenerationAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "plan"]
    }
  },
  "firestore": {
    "/generations/{generationId}": {
      "schema": "ThumbnailGeneration",
      "description": "Collection of all thumbnail generations"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data"
    }
  }
}
